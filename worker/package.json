{
  "name": "@typing-race/worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run migrate:local && wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:k6": "wrangler deploy --env k6",
    "migrate:local": "wrangler d1 migrations apply typing-race-db --local",
    "migrate:remote": "wrangler d1 migrations apply typing-race-db --remote",
    "migrate:k6": "wrangler d1 migrations apply typing-race-db-k6 --remote --env k6",
    "tail": "wrangler tail",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260418.1",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.83.0"
  },
  "dependencies": {
    "@sentry/cloudflare": "^10.49.0"
  }
}
